{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-resell-broker/schemas/intent-mandate.json",
  "title": "IntentMandate",
  "description": "AP2 purchase intent authorized by the buyer's Solana ed25519 wallet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_cart_confirmation_required",
    "natural_language_description",
    "price_ceiling",
    "ship_to",
    "intent_expiry",
    "signature"
  ],
  "properties": {
    "user_cart_confirmation_required": { "type": "boolean" },
    "natural_language_description": { "type": "string" },
    "merchants": { "type": ["array", "null"], "items": { "type": "string" } },
    "skus": { "type": ["array", "null"], "items": { "type": "string" } },
    "requires_refundability": { "type": ["boolean", "null"], "default": false },
    "price_ceiling": { "$ref": "#/$defs/money" },
    "ship_to": { "type": "string" },
    "shipping_address": {
      "oneOf": [
        { "$ref": "#/$defs/structuredShippingAddress" },
        { "type": "null" }
      ]
    },
    "intent_expiry": { "type": "string", "format": "date-time" },
    "signer_wallet": {
      "type": "string",
      "description": "Signed-in human Solana wallet for delegated intents; omitted for the agent-only compatibility path."
    },
    "delegator": {
      "type": "string",
      "description": "Clerk-verified Solana wallet whose USDC ATA granted the SPL delegate."
    },
    "delegateAuthority": {
      "type": "string",
      "description": "Broker buyer-agent wallet authorized as the SPL delegate."
    },
    "allowanceRemaining": {
      "allOf": [{ "$ref": "#/$defs/money" }],
      "description": "Signed on-chain allowance snapshot; payments re-read the account before every spend."
    },
    "approvalTxSignature": {
      "type": "string",
      "minLength": 1,
      "description": "Devnet transaction in which the user approved the SPL delegate."
    },
    "signature": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,6})?$" },
        "currency": { "const": "USDC" }
      }
    },
    "structuredShippingAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address1",
        "city",
        "province",
        "country",
        "zip"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address1": { "type": "string", "minLength": 1 },
        "address2": { "type": ["string", "null"], "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "province": { "type": "string", "minLength": 1 },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO-3166-1 alpha-2 country code"
        },
        "zip": { "type": "string", "minLength": 3 },
        "phone": { "type": ["string", "null"], "minLength": 5 }
      }
    }
  }
}
