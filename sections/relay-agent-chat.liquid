{% comment %}
  The chat owns the whole first screen. Locking page scroll here rather than
  inside the component, because the shadow root cannot reach <body>.
{% endcomment %}
<style>
  body:has(.relay-agent-chat-section) { overflow: hidden; }
  .relay-agent-chat-section { overflow: hidden; }
</style>
<section class="relay-agent-chat-section">
  <relay-agent-chat
    agent-base-url="{{ section.settings.agent_base_url | escape }}"
    ship-to="{{ section.settings.ship_to | escape }}"
    heading="{{ section.settings.heading | escape }}"
    intro="{{ section.settings.intro | escape }}"
    currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
    shopify-login-url="{{ routes.storefront_login_url | escape }}"
  >
    <script type="application/json" data-relay-catalog>
      [
        {%- for product in collections.all.products limit: 50 -%}
          {
            "id": {{ product.id | json }},
            "handle": {{ product.handle | json }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
            "priceCents": {{ product.price | json }},
            "available": {{ product.available | json }},
            "description": {{ product.description | strip_html | truncate: 180 | json }},
            "tags": {{ product.tags | join: ' ' | json }},
            "vendor": {{ product.vendor | json }},
            "sku": {{ product.selected_or_first_available_variant.sku | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </relay-agent-chat>
</section>

{% raw %}
<script>
(() => {
  if (customElements.get("relay-agent-chat")) return;

  const view = document.createElement("template");
  view.innerHTML = `
    <style>
      :host {
        --relay-bg: #f5f4ef;
        --relay-paper: #fbfaf6;
        --relay-ink: #11110f;
        --relay-muted: #67675f;
        --relay-rule: #d5d4cc;
        --relay-soft: #e9e8e1;
        --relay-accent: #3157c8;
        display: block;
        /* The landing view is one screen: the page never scrolls, only the
           conversation and the showcase rail do. */
        height: var(--relay-viewport, calc(100dvh - 70px));
        color: var(--relay-ink);
        background: var(--relay-bg);
        font: 400 15px/1.45 Inter, "Helvetica Neue", Helvetica, Arial, system-ui, sans-serif;
        font-synthesis: none;
      }

      * { box-sizing: border-box; }
      button, input { font: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }
      button:focus-visible, input:focus-visible, a:focus-visible {
        outline: 2px solid var(--relay-accent);
        outline-offset: 3px;
      }

      .shell {
        display: grid;
        grid-template-areas: "showcase chat";
        grid-template-columns: minmax(0, .96fr) minmax(0, 1.04fr);
        height: 100%;
        min-height: 0;
        overflow: hidden;
        border-top: 1px solid var(--relay-rule);
        border-bottom: 1px solid var(--relay-rule);
      }

      .chat {
        display: grid;
        grid-area: chat;
        grid-template-rows: minmax(360px, 1fr) auto;
        min-width: 0;
        max-height: min(900px, calc(100vh - 70px));
        background: var(--relay-paper);
      }

      .showcase {
        display: grid;
        grid-area: showcase;
        grid-template-rows: minmax(0, 1fr) auto;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        border-right: 1px solid var(--relay-rule);
        background: var(--relay-bg);
      }

      .showcase-viewport {
        position: relative;
        min-height: 0;
        overflow: hidden;
      }

      .showcase-slides,
      .showcase-slide {
        width: 100%;
        height: 100%;
      }

      .showcase-slide {
        display: grid;
        grid-template-rows: minmax(260px, 1.15fr) minmax(240px, .85fr);
      }

      .showcase-slide[hidden] { display: none; }

      .showcase-image {
        position: relative;
        min-height: 0;
        overflow: hidden;
        border-bottom: 1px solid var(--relay-rule);
        background: var(--relay-soft);
      }

      .showcase-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .showcase-badge {
        position: absolute;
        top: 18px;
        left: 18px;
        padding: 7px 9px;
        background: rgba(251, 250, 246, .94);
        color: var(--relay-ink);
      }

      .showcase-copy {
        display: flex;
        min-height: 0;
        flex-direction: column;
        padding: clamp(24px, 4vw, 48px);
      }

      .showcase-kicker,
      .showcase-badge,
      .showcase-status,
      .message-label,
      .state,
      .proof-kicker,
      .catalog-meta,
      .step-number,
      .inline-kicker {
        font: 650 10px/1.25 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        letter-spacing: .09em;
        text-transform: uppercase;
      }

      .showcase-kicker {
        display: block;
        margin-bottom: 18px;
        color: var(--relay-accent);
      }

      .showcase-copy h2 {
        max-width: 620px;
        margin: 0;
        font-size: clamp(34px, 4vw, 64px);
        font-weight: 520;
        line-height: .98;
        letter-spacing: -.05em;
      }

      .showcase-copy > p {
        max-width: 520px;
        margin: 18px 0 0;
        color: var(--relay-muted);
        font-size: clamp(13px, 1.3vw, 17px);
      }

      .showcase-facts {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-top: auto;
        padding-top: 22px;
        border-top: 1px solid var(--relay-rule);
      }

      .showcase-facts strong {
        font: 650 14px/1.25 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      .showcase-facts span {
        color: var(--relay-muted);
        font-size: 11px;
        text-align: right;
      }

      .showcase-link {
        width: fit-content;
        margin-top: 18px;
        color: var(--relay-ink);
        font-size: 12px;
        text-underline-offset: 4px;
      }

      .protocol-visual {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: clamp(8px, 2vw, 24px);
        height: 100%;
        padding: clamp(28px, 5vw, 64px);
        color: var(--relay-paper);
        background: var(--relay-ink);
      }

      .protocol-node {
        display: grid;
        place-items: center;
        min-width: 0;
        aspect-ratio: 1;
        border: 1px solid #81817b;
        border-radius: 50%;
        font: 650 clamp(9px, 1vw, 12px)/1.25 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        letter-spacing: .08em;
        text-align: center;
        text-transform: uppercase;
      }

      .protocol-node.accent {
        border-color: #9fb1ef;
        color: #b8c5f5;
      }

      .protocol-arrow {
        color: #9b9b93;
        font-size: clamp(18px, 3vw, 34px);
      }

      .relay-visual {
        position: relative;
        display: grid;
        place-items: center;
        height: 100%;
        overflow: hidden;
        color: var(--relay-paper);
        background: var(--relay-accent);
      }

      .relay-visual::before,
      .relay-visual::after {
        position: absolute;
        width: 68%;
        aspect-ratio: 1;
        border: 1px solid rgba(255, 255, 255, .4);
        border-radius: 50%;
        content: "";
      }

      .relay-visual::after {
        width: 42%;
        border-color: rgba(255, 255, 255, .65);
      }

      .relay-mark {
        z-index: 1;
        font-size: clamp(64px, 11vw, 150px);
        font-weight: 500;
        letter-spacing: -.075em;
      }

      .showcase-controls {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        min-height: 58px;
        border-top: 1px solid var(--relay-rule);
      }

      .showcase-controls button {
        width: 58px;
        height: 58px;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--relay-ink);
        cursor: pointer;
        font-size: 22px;
      }

      .showcase-controls button:first-child {
        border-right: 1px solid var(--relay-rule);
      }

      .showcase-controls button:last-child {
        border-left: 1px solid var(--relay-rule);
      }

      .showcase-controls button:hover:not(:disabled) {
        color: var(--relay-accent);
      }

      .showcase-status {
        color: var(--relay-muted);
        text-align: center;
      }

      .messages {
        min-height: 0;
        overflow: auto;
        padding: clamp(28px, 4vw, 54px) clamp(18px, 3.2vw, 44px);
        scroll-behavior: smooth;
      }

      .message {
        display: grid;
        grid-template-columns: 62px minmax(0, 1fr);
        gap: 13px;
        max-width: 900px;
        margin: 0 0 34px;
      }

      .message.user { margin-left: auto; }
      .message-label {
        padding-top: 4px;
        color: var(--relay-muted);
      }
      .message.agent .message-label { color: var(--relay-accent); }

      .message-body {
        min-width: 0;
        font-size: clamp(16px, 1.6vw, 20px);
        letter-spacing: -.015em;
      }

      .message-body > p { margin: 0; white-space: pre-wrap; }
      .message.user .message-body {
        padding: 16px 18px;
        border: 1px solid var(--relay-rule);
        background: var(--relay-bg);
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 18px;
      }

      .card {
        display: flex;
        min-width: 0;
        flex-direction: column;
        border: 1px solid var(--relay-rule);
        background: var(--relay-paper);
      }

      .card-media {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4 / 3;
        border-bottom: 1px solid var(--relay-rule);
        background: var(--relay-soft);
      }

      .card-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        mix-blend-mode: multiply;
      }

      .stock {
        position: absolute;
        top: 9px;
        left: 9px;
        padding: 5px 7px;
        background: rgba(251, 250, 246, .94);
        font: 650 9px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .card-copy {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 14px;
      }

      .card h3 {
        min-height: 2.65em;
        margin: 0;
        font-size: 14px;
        font-weight: 560;
        line-height: 1.3;
        letter-spacing: -.015em;
      }

      .price {
        margin: 12px 0 0;
        font: 650 13px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      .catalog-meta {
        display: block;
        margin-top: 5px;
        color: var(--relay-muted);
        font-size: 8px;
      }

      .card-actions {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        margin-top: auto;
        padding-top: 16px;
      }

      .primary, .secondary, .send {
        min-height: 42px;
        border: 1px solid var(--relay-ink);
        border-radius: 0;
        cursor: pointer;
        transition: background .16s ease, color .16s ease, opacity .16s ease;
      }

      .primary, .send {
        background: var(--relay-ink);
        color: var(--relay-paper);
      }

      .primary { padding: 9px 12px; font-size: 12px; }
      .secondary {
        padding: 9px 12px;
        background: transparent;
        color: var(--relay-ink);
        text-decoration: none;
        font-size: 12px;
        text-align: center;
      }

      .primary:hover, .send:hover { background: var(--relay-accent); border-color: var(--relay-accent); }
      .secondary:hover { color: var(--relay-accent); border-color: var(--relay-accent); }
      button:disabled { cursor: not-allowed; opacity: .42; }

      .delegate {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 12px;
        padding: 14px 0;
        border-top: 1px solid var(--relay-rule);
        border-bottom: 1px solid var(--relay-rule);
      }

      .delegate span {
        color: var(--relay-muted);
        font-size: 12px;
      }

      .delegate .primary { flex: 0 0 auto; }

      .inline-actions {
        display: grid;
        gap: 13px;
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--relay-rule);
        background: var(--relay-bg);
      }

      .inline-kicker {
        color: var(--relay-accent);
      }

      .inline-note {
        margin: 0;
        color: var(--relay-muted);
        font-size: 12px;
      }

      .inline-action-row {
        display: flex;
        align-items: end;
        flex-wrap: wrap;
        gap: 10px;
      }

      .inline-limit {
        display: grid;
        gap: 5px;
        color: var(--relay-muted);
        font: 600 9px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        letter-spacing: .05em;
        text-transform: uppercase;
      }

      .inline-limit input {
        width: 104px;
        min-height: 42px;
        padding: 8px 10px;
        border: 1px solid var(--relay-rule);
        border-radius: 0;
        background: var(--relay-paper);
        color: var(--relay-ink);
      }

      .inline-delegation-status {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid var(--relay-rule);
        color: var(--relay-muted);
        font: 500 9px/1.35 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        letter-spacing: .04em;
        text-transform: uppercase;
      }

      .quiet-action {
        padding: 3px 0;
        border: 0;
        border-bottom: 1px solid currentColor;
        border-radius: 0;
        background: transparent;
        color: var(--relay-muted);
        cursor: pointer;
        font-size: 9px;
        text-transform: uppercase;
      }

      .quiet-action:hover:not(:disabled) { color: var(--relay-accent); }

      .progress {
        margin-top: 18px;
        border: 1px solid var(--relay-rule);
        background: var(--relay-bg);
      }

      .progress-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 17px;
        border-bottom: 1px solid var(--relay-rule);
      }

      .progress-title { font-weight: 570; }
      .state { color: var(--relay-muted); }
      .state.active, .state.done { color: var(--relay-accent); }

      .step {
        display: grid;
        grid-template-columns: 32px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: start;
        padding: 14px 17px;
        border-bottom: 1px solid var(--relay-rule);
      }
      .step:last-of-type { border-bottom: 0; }
      .step-number { color: var(--relay-muted); }
      .step strong { display: block; font-size: 13px; font-weight: 560; }
      .step p { margin: 3px 0 0; color: var(--relay-muted); font-size: 11px; }
      .step-value {
        overflow: hidden;
        max-width: 190px;
        color: var(--relay-muted);
        font: 500 10px/1.3 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        text-align: right;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .proof {
        display: grid;
        gap: 11px;
        padding: 18px;
        border-top: 1px solid var(--relay-ink);
        background: var(--relay-ink);
        color: var(--relay-paper);
      }

      .proof-kicker { color: #9fb1ef; }
      .proof a {
        width: fit-content;
        color: var(--relay-paper);
        font-size: clamp(18px, 2.5vw, 30px);
        font-weight: 560;
        letter-spacing: -.025em;
        text-underline-offset: 5px;
      }
      .proof-code {
        overflow: hidden;
        font: 500 10px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .composer {
        padding: 14px clamp(20px, 3.2vw, 44px) 18px;
        border-top: 1px solid var(--relay-rule);
        background: var(--relay-paper);
      }

      .composer form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        border-bottom: 1px solid var(--relay-ink);
      }

      .composer input {
        min-width: 0;
        min-height: 54px;
        padding: 10px 8px 10px 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--relay-ink);
        font-size: 16px;
      }
      .composer input:focus { outline: 0; }
      .composer input::placeholder { color: #8b8b83; }
      .send {
        align-self: center;
        min-height: 38px;
        padding: 8px 18px;
      }
      .composer-note {
        margin: 10px 0 0;
        color: var(--relay-muted);
        font-size: 8px;
      }

      @media (max-width: 980px) {
        :host, .shell { min-height: auto; }
        .shell {
          grid-template-areas:
            "chat"
            "showcase";
          grid-template-columns: minmax(0, 1fr);
        }
        .chat { min-height: 72vh; max-height: none; }
        .messages { min-height: 480px; }
        .showcase {
          min-height: 680px;
          border-top: 1px solid var(--relay-rule);
          border-right: 0;
        }
      }

      @media (max-width: 720px) {
        .message { grid-template-columns: 56px minmax(0, 1fr); gap: 10px; }
        .cards { grid-template-columns: 1fr; }
        .card { display: grid; grid-template-columns: 116px minmax(0, 1fr); }
        .card-media { aspect-ratio: auto; border-right: 1px solid var(--relay-rule); border-bottom: 0; }
        .step { grid-template-columns: 26px minmax(0, 1fr); }
        .step-value { grid-column: 2; max-width: none; text-align: left; }
        .delegate { align-items: stretch; flex-direction: column; }
        .composer { padding-inline: 16px; }
        .showcase { min-height: 620px; }
        .showcase-slide { grid-template-rows: minmax(250px, 1fr) auto; }
        .showcase-copy { padding: 28px 22px; }
        .showcase-copy h2 { font-size: clamp(32px, 11vw, 48px); }
        .protocol-visual { padding: 28px 18px; }
        .protocol-node { font-size: 8px; }
        .inline-action-row { align-items: stretch; flex-direction: column; }
        .inline-limit input { width: 100%; }
      }

      @media (prefers-reduced-motion: reduce) {
        .messages { scroll-behavior: auto; }
        .primary, .secondary, .send { transition: none; }
      }
    </style>

    <main class="shell">
      <section class="chat" aria-label="Relay shopping chat">
        <div class="messages" id="messages" role="log" aria-live="polite" aria-relevant="additions"></div>
        <footer class="composer">
          <form id="composer">
            <input
              id="prompt"
              type="text"
              maxlength="240"
              autocomplete="off"
              aria-label="Describe what you want to buy"
              placeholder="wireless earbuds under 10 dollars"
            >
            <button class="send" id="send" type="submit">Send ↗</button>
          </form>
        </footer>
      </section>
      <aside class="showcase" aria-label="Relay live catalog and project">
        <div
          class="showcase-viewport"
          id="showcase-viewport"
          role="region"
          aria-roledescription="carousel"
          aria-label="Live catalog, MCP, and Relay overview"
          tabindex="0"
        >
          <div class="showcase-slides" id="showcase-slides"></div>
        </div>
        <nav class="showcase-controls" aria-label="Showcase controls">
          <button id="showcase-prev" type="button" aria-label="Previous slide">←</button>
          <span class="showcase-status" id="showcase-status"></span>
          <button id="showcase-next" type="button" aria-label="Next slide">→</button>
        </nav>
      </aside>
    </main>
  `;

  class RelayAgentChat extends HTMLElement {
    connectedCallback() {
      if (this.shadowRoot) return;

      const catalogNode = this.querySelector("[data-relay-catalog]");
      this.catalog = this.parseCatalog(catalogNode?.textContent || "[]");
      this.baseUrl = this.cleanBaseUrl(this.getAttribute("agent-base-url") || "");
      this.shipTo = (this.getAttribute("ship-to") || "").trim() || "Google Startup Campus, Seoul, KR";
      this.currency = (this.getAttribute("currency") || "USD").trim().toUpperCase();
      this.lastCandidates = [];
      this.lastIntent = null;
      this.busy = false;
      this.history = [];
      this.cluster = "devnet";
      this.walletAddress = "";
      this.authClient = null;
      this.identity = null;
      this.authBranch = "initializing";
      this.delegation = null;
      this.authError = "";
      this.pendingPurchase = null;
      this.resumeInFlight = false;
      this.activeGate = null;
      this.showcaseIndex = 0;
      this.showcaseTimer = null;
      this.reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      this.shopifyLoginUrl =
        (this.getAttribute("shopify-login-url") || "/customer_authentication/login").trim();
      this.sessionKey = `relay-agent-chat:${window.location.pathname}`;
      this.agentSessionKey = `relay-agent-session:${window.location.pathname}`;
      this.pendingPurchaseKey = `relay-pending-purchase:${window.location.pathname}`;
      this.agentSessionId = this.loadAgentSessionId();
      this.pendingPurchase = this.loadPendingPurchase();

      this.attachShadow({ mode: "open" }).append(view.content.cloneNode(true));
      this.$ = (selector) => this.shadowRoot.querySelector(selector);
      this.$("#composer").addEventListener("submit", (event) => this.submit(event));
      this.initShowcase();

      if (!this.restoreHistory()) {
        this.appendMessage(
          "agent",
          "What are you looking for? Tell me your budget and shipping destination, and I’ll compare this store’s live catalog. You stay in control until you choose an item or delegate the choice.",
        );
      }
      this.loadAuth();
    }

    disconnectedCallback() {
      window.clearInterval(this.showcaseTimer);
      this.showcaseTimer = null;
    }

    cleanBaseUrl(value) {
      return value.trim().replace(/\/+$/, "");
    }

    isConfigured() {
      return Boolean(this.baseUrl) && !/YOUR-|localhost|127\.0\.0\.1|example\.com/i.test(this.baseUrl);
    }

    parseCatalog(value) {
      try {
        const parsed = JSON.parse(value);
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    initShowcase() {
      const slides = this.catalog
        .filter((product) => product?.available && product?.image)
        .map((product, index) => this.createProductSlide(product, index));
      slides.push(
        this.createInfoSlide("mcp"),
        this.createInfoSlide("relay"),
      );
      const track = this.$("#showcase-slides");
      slides.forEach((slide) => track.append(slide));
      this.showcaseSlides = slides;

      this.$("#showcase-prev").addEventListener("click", () =>
        this.setShowcaseSlide(this.showcaseIndex - 1, { userInitiated: true }),
      );
      this.$("#showcase-next").addEventListener("click", () =>
        this.setShowcaseSlide(this.showcaseIndex + 1, { userInitiated: true }),
      );
      const viewport = this.$("#showcase-viewport");
      viewport.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const direction = event.key === "ArrowLeft" ? -1 : 1;
        this.setShowcaseSlide(this.showcaseIndex + direction, { userInitiated: true });
      });
      viewport.addEventListener("mouseenter", () => this.stopShowcase());
      viewport.addEventListener("mouseleave", () => this.startShowcase());
      this.$(".showcase").addEventListener("focusin", () => this.stopShowcase());
      this.$(".showcase").addEventListener("focusout", (event) => {
        if (!this.$(".showcase").contains(event.relatedTarget)) this.startShowcase();
      });
      this.reducedMotion.addEventListener?.("change", () => {
        this.stopShowcase();
        this.startShowcase();
      });

      this.setShowcaseSlide(0);
      this.startShowcase();
    }

    createProductSlide(product, index) {
      const slide = document.createElement("article");
      slide.className = "showcase-slide";
      slide.setAttribute("aria-roledescription", "slide");
      slide.setAttribute("aria-label", `Live catalog product ${index + 1}`);

      const media = document.createElement("div");
      media.className = "showcase-image";
      const image = document.createElement("img");
      image.src = product.image;
      image.alt = product.title || "Live catalog product";
      image.loading = index === 0 ? "eager" : "lazy";
      image.decoding = "async";
      image.addEventListener("error", () => {
        const slideIndex = this.showcaseSlides?.indexOf(slide);
        slide.remove();
        if (slideIndex >= 0) {
          this.showcaseSlides.splice(slideIndex, 1);
          this.setShowcaseSlide(Math.min(this.showcaseIndex, this.showcaseSlides.length - 1));
        }
      });
      const badge = document.createElement("span");
      badge.className = "showcase-badge";
      badge.textContent = "Live Shopify catalog";
      media.append(image, badge);

      const copy = document.createElement("div");
      copy.className = "showcase-copy";
      const title = document.createElement("h2");
      // Supplier descriptions are raw spec dumps ("SPECIFICATIONS Brand Name:
      // …"), so the slide shows the title and price only.
      title.textContent = product.title || "Untitled product";
      const facts = document.createElement("div");
      facts.className = "showcase-facts";
      const price = document.createElement("strong");
      price.textContent = this.formatMoney(product);
      const stock = document.createElement("span");
      stock.textContent = product.available ? "Available now" : "Currently unavailable";
      facts.append(price, stock);
      copy.append(title, facts);
      if (product.url || product.handle) {
        const link = document.createElement("a");
        link.className = "showcase-link";
        link.href = product.url || `/products/${encodeURIComponent(product.handle)}`;
        link.textContent = "View live product ↗";
        link.setAttribute("aria-label", `View ${product.title || "catalog product"}`);
        copy.append(link);
      }
      slide.append(media, copy);
      return slide;
    }

    createInfoSlide(kind) {
      const slide = document.createElement("article");
      slide.className = "showcase-slide";
      slide.setAttribute("aria-roledescription", "slide");
      if (kind === "mcp") {
        slide.setAttribute("aria-label", "Relay MCP overview");
        slide.innerHTML = `
          <div class="showcase-image protocol-visual" aria-hidden="true">
            <span class="protocol-node">External<br>agent</span>
            <span class="protocol-arrow">→</span>
            <span class="protocol-node accent">Relay<br>MCP</span>
            <span class="protocol-arrow">→</span>
            <span class="protocol-node">USDC<br>Solana</span>
          </div>
          <div class="showcase-copy">
            <span class="showcase-kicker">Model Context Protocol</span>
            <h2>Agents can shop here, too.</h2>
            <p>Authenticated external agents connect through Relay’s MCP adapter, source real inventory, and settle agent-to-agent without opening a human checkout.</p>
            <div class="showcase-facts">
              <strong>MCP + A2A</strong>
              <span>Authenticated tools<br>On-chain verification</span>
            </div>
          </div>
        `;
      } else {
        const heading = (this.getAttribute("heading") || "Tell it what you need.").trim();
        const intro = (this.getAttribute("intro") ||
          "Search the live catalog, set a budget, and let the agent settle in USDC on Solana devnet.").trim();
        slide.setAttribute("aria-label", "About Relay");
        slide.innerHTML = `
          <div class="showcase-image relay-visual" aria-hidden="true">
            <span class="relay-mark">Relay</span>
          </div>
          <div class="showcase-copy">
            <span class="showcase-kicker">Agent-native commerce</span>
            <h2></h2>
            <p></p>
            <div class="showcase-facts">
              <strong>USDC · Devnet</strong>
              <span>Autonomous signing<br>Explorer proof</span>
            </div>
          </div>
        `;
        slide.querySelector("h2").textContent = heading;
        slide.querySelector("p").textContent = intro;
      }
      return slide;
    }

    setShowcaseSlide(index, options = {}) {
      const count = this.showcaseSlides?.length || 0;
      if (!count) return;
      this.showcaseIndex = (index % count + count) % count;
      this.showcaseSlides.forEach((slide, slideIndex) => {
        const active = slideIndex === this.showcaseIndex;
        slide.hidden = !active;
        slide.setAttribute("aria-hidden", String(!active));
      });
      this.$("#showcase-status").textContent =
        `${String(this.showcaseIndex + 1).padStart(2, "0")} / ${String(count).padStart(2, "0")}`;
      if (options.userInitiated) {
        this.stopShowcase();
        this.startShowcase();
      }
    }

    startShowcase() {
      if (this.reducedMotion.matches || this.showcaseSlides?.length < 2 || this.showcaseTimer) {
        return;
      }
      this.showcaseTimer = window.setInterval(() => {
        if (!document.hidden) this.setShowcaseSlide(this.showcaseIndex + 1);
      }, 6500);
    }

    stopShowcase() {
      window.clearInterval(this.showcaseTimer);
      this.showcaseTimer = null;
    }

    loadAgentSessionId() {
      try {
        const saved = sessionStorage.getItem(this.agentSessionKey);
        if (saved && /^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$/.test(saved)) return saved;
        const generated = globalThis.crypto?.randomUUID?.().replaceAll("-", "") ||
          `relay${Date.now().toString(36)}${Math.random().toString(36).slice(2)}`;
        sessionStorage.setItem(this.agentSessionKey, generated);
        return generated;
      } catch {
        return `relay${Date.now().toString(36)}${Math.random().toString(36).slice(2)}`;
      }
    }

    restoreHistory() {
      try {
        const saved = JSON.parse(sessionStorage.getItem(this.sessionKey) || "[]");
        if (!Array.isArray(saved) || !saved.length) return false;
        saved.slice(-18).forEach((message) => {
          if (message?.role && message?.text) {
            this.appendMessage(message.role, message.text, { save: false });
          }
        });
        this.history = saved.slice(-18);
        return true;
      } catch {
        return false;
      }
    }

    saveHistory() {
      try {
        sessionStorage.setItem(this.sessionKey, JSON.stringify(this.history.slice(-18)));
      } catch {}
    }

    appendMessage(role, text, options = {}) {
      const message = document.createElement("article");
      message.className = `message ${role === "user" ? "user" : "agent"}`;

      const label = document.createElement("span");
      label.className = "message-label";
      label.textContent = role === "user" ? "You" : "Relay";

      const body = document.createElement("div");
      body.className = "message-body";
      const copy = document.createElement("p");
      copy.textContent = text;
      body.append(copy);
      message.append(label, body);
      this.$("#messages").append(message);

      if (options.save !== false) {
        this.history.push({ role: role === "user" ? "user" : "agent", text });
        this.saveHistory();
      }
      this.scrollToLatest();
      return { message, body };
    }

    scrollToLatest() {
      requestAnimationFrame(() => {
        const list = this.$("#messages");
        list.scrollTop = list.scrollHeight;
      });
    }

    errorMessage(error) {
      if (typeof error === "string") return error;
      if (Array.isArray(error)) {
        return error.map((item) => item?.msg || JSON.stringify(item)).join(", ");
      }
      return error?.message || "The agent request failed.";
    }

    authEvidence() {
      return {
        branch: this.authBranch,
        events: this.authClient?.telemetry?.() || [],
      };
    }

    async fetchJson(path, options = {}) {
      if (!this.isConfigured()) {
        throw new Error("The buyer agent URL is not configured for this section.");
      }
      let parsedBase;
      try {
        parsedBase = new URL(this.baseUrl);
      } catch {
        throw new Error("agent-base-url is not a valid URL.");
      }
      if (window.location.protocol === "https:" && parsedBase.protocol !== "https:") {
        throw new Error("Shopify requires an HTTPS buyer-agent URL.");
      }

      const response = await fetch(this.baseUrl + path, { mode: "cors", ...options });
      const responseText = await response.text();
      let payload = {};
      try {
        payload = responseText ? JSON.parse(responseText) : {};
      } catch {
        throw new Error(responseText || `Invalid response from ${path}`);
      }
      if (!response.ok) {
        throw new Error(this.errorMessage(payload.detail || payload.reason || `HTTP ${response.status}`));
      }
      if (payload.error) throw new Error(this.errorMessage(payload.error));
      return payload;
    }

    async loadAuthScript() {
      if (window.RelayAuth) return;
      await new Promise((resolve, reject) => {
        const src = `${this.baseUrl}/auth-client.js`;
        const existing = [...document.scripts].find((script) => script.src === src);
        if (existing) {
          if (window.RelayAuth) resolve();
          else if (existing.dataset.relayAuthState === "error") {
            existing.remove();
          }
          else {
            existing.addEventListener("load", resolve, { once: true });
            existing.addEventListener("error", reject, { once: true });
            return;
          }
          if (window.RelayAuth) return;
        }
        const script = document.createElement("script");
        script.src = src;
        script.crossOrigin = "anonymous";
        script.dataset.relayAuthState = "loading";
        script.onload = () => {
          script.dataset.relayAuthState = "loaded";
          resolve();
        };
        script.onerror = () => {
          script.dataset.relayAuthState = "error";
          reject(new Error("Unable to load Relay wallet identity."));
        };
        document.head.append(script);
      });
    }

    async loadAuth() {
      if (!this.isConfigured()) {
        this.authError = "The buyer agent URL is not configured for this section.";
        return null;
      }
      if (this.authClient) return this.authClient;
      if (this.authLoadPromise) return this.authLoadPromise;
      this.authLoadPromise = (async () => {
        try {
          await this.loadAuthScript();
          this.authClient = window.RelayAuth.client(this.baseUrl);
          this.authClient.subscribe((identity) => this.updateIdentity(identity));
          const status = await this.authClient.ready;
          this.applyAuthStatus(status);
          if (!status.configured) {
            this.authError = "Shopify sign-in is temporarily unavailable.";
          } else {
            this.authError = "";
          }
          if (!status.sessionActive && this.pendingPurchase) {
            this.showAuthStatusGate(
              this.pendingPurchase.product,
              this.pendingPurchase.options,
              status,
            );
          }
          return this.authClient;
        } catch (error) {
          this.authError = this.errorMessage(error);
          this.authLoadPromise = null;
          if (this.pendingPurchase) {
            this.showAuthGate(
              this.pendingPurchase.product,
              this.pendingPurchase.options,
            );
          }
          return null;
        }
      })();
      return this.authLoadPromise;
    }

    async updateIdentity(identity) {
      this.identity = identity;
      const authStatus = this.authClient?.status?.();
      this.applyAuthStatus(authStatus);
      if (!authStatus?.sessionActive) {
        this.delegation = null;
        if (this.pendingPurchase && this.authBranch !== "initializing") {
          this.showAuthStatusGate(
            this.pendingPurchase.product,
            this.pendingPurchase.options,
            authStatus,
          );
        }
        return;
      }
      if (!identity?.walletAddress) {
        this.delegation = null;
        if (this.pendingPurchase) {
          this.showWalletGate(
            this.pendingPurchase.product,
            this.pendingPurchase.options,
          );
        }
        return;
      }
      await this.refreshDelegation();
      await this.maybeResumePendingPurchase();
    }

    applyAuthStatus(status) {
      if (!status?.branch) return;
      this.authBranch = status.branch;
      this.dataset.authBranch = status.branch;
      this.dataset.authBranchSource = status.source || "";
    }

    loadPendingPurchase() {
      try {
        const pending = JSON.parse(sessionStorage.getItem(this.pendingPurchaseKey) || "null");
        if (!pending?.product || !Number.isFinite(pending?.createdAt)) return null;
        if (Date.now() - pending.createdAt > 30 * 60 * 1000) {
          sessionStorage.removeItem(this.pendingPurchaseKey);
          return null;
        }
        return pending;
      } catch {
        return null;
      }
    }

    rememberPendingPurchase(product, options = {}) {
      const budget = Number(options.budget || this.lastIntent?.budget || this.defaultBudget(product));
      this.pendingPurchase = {
        product,
        options: {
          budget,
          announceSelection: options.announceSelection !== false,
        },
        createdAt: Date.now(),
      };
      try {
        sessionStorage.setItem(
          this.pendingPurchaseKey,
          JSON.stringify(this.pendingPurchase),
        );
      } catch {}
      return this.pendingPurchase;
    }

    clearPendingPurchase() {
      this.pendingPurchase = null;
      try {
        sessionStorage.removeItem(this.pendingPurchaseKey);
      } catch {}
    }

    deactivatePurchaseGates() {
      this.shadowRoot.querySelectorAll("[data-purchase-gate]").forEach((message) => {
        message.querySelector(".inline-actions")?.remove();
        delete message.dataset.purchaseGate;
        delete message.dataset.purchaseKey;
      });
      this.activeGate = null;
    }

    purchaseGateKey(kind, product, options = {}) {
      const identity = product?.variantId || product?.sku || product?.id || product?.title || "product";
      return `${kind}:${identity}:${Number(options.budget || 0).toFixed(2)}`;
    }

    createPurchaseGate(kind, text, key = kind) {
      if (this.activeGate?.isConnected && this.activeGate.dataset.purchaseKey === key) {
        return null;
      }
      this.deactivatePurchaseGates();
      const { message, body } = this.appendMessage("agent", text);
      message.dataset.purchaseGate = kind;
      message.dataset.purchaseKey = key;
      const panel = document.createElement("div");
      panel.className = "inline-actions";
      body.append(panel);
      this.activeGate = message;
      return panel;
    }

    showAuthGate(product, options = {}, gateOptions = {}) {
      this.rememberPendingPurchase(product, options);
      const panel = this.createPurchaseGate(
        gateOptions.continuation ? "auth-continuation" : "auth",
        gateOptions.continuation
          ? `Continue sign-in to buy ${product.title}. Search and comparison are still available without signing in.`
          : `Sign in only when you’re ready to buy ${product.title}. Search and comparison stay available without an account.`,
        this.purchaseGateKey(
          gateOptions.continuation ? "auth-continuation" : "auth",
          product,
          options,
        ),
      );
      if (!panel) return;
      const kicker = document.createElement("span");
      kicker.className = "inline-kicker";
      kicker.textContent = "Payment identity required";
      const note = document.createElement("p");
      note.className = "inline-note";
      note.textContent = this.authError ||
        "Shopify starts the verified Clerk session; payment never goes through Shopify checkout.";
      const button = document.createElement("button");
      button.className = "primary";
      button.type = "button";
      button.textContent = gateOptions.continuation
        ? "Continue secure sign-in"
        : "Sign in with Shopify";
      button.addEventListener("click", () => this.toggleAuth(button));
      panel.append(kicker, note, button);
      this.scrollToLatest();
    }

    showAuthStatusGate(product, options = {}, status = this.authClient?.status?.()) {
      if (status?.fallbackExhausted) {
        this.showAuthFailureGate(product, options, status);
        return;
      }
      if (status?.fallbackRetrying) {
        this.showAuthRetryGate(product, options, status);
        return;
      }
      this.showAuthGate(product, options, {
        continuation: status?.branch === "shopify_return_fallback",
      });
    }

    showAuthRetryGate(product, options = {}, status = {}) {
      this.rememberPendingPurchase(product, options);
      const panel = this.createPurchaseGate(
        "auth-sso-retry",
        `Finishing secure sign-in before buying ${product.title}. Clerk SSO is making its one bounded retry now.`,
        this.purchaseGateKey("auth-sso-retry", product, options),
      );
      if (!panel) return;
      const kicker = document.createElement("span");
      kicker.className = "inline-kicker";
      kicker.textContent = "Secure sign-in returning";
      const note = document.createElement("p");
      note.className = "inline-note";
      note.textContent =
        "Only one automatic retry is allowed. Search and comparison remain available; no payment has been attempted.";
      panel.append(kicker, note);
      this.scrollToLatest();
    }

    showAuthFailureGate(product, options = {}, status = {}) {
      this.rememberPendingPurchase(product, options);
      const panel = this.createPurchaseGate(
        "auth-sso-failed",
        `Secure sign-in could not establish a storefront session for ${product.title}. Automatic redirects have stopped.`,
        this.purchaseGateKey("auth-sso-failed", product, options),
      );
      if (!panel) return;
      const kicker = document.createElement("span");
      kicker.className = "inline-kicker";
      kicker.textContent = "Sign-in needs browser attention";
      const note = document.createElement("p");
      note.className = "inline-note";
      note.textContent =
        `${status.fallbackMessage || "Clerk SSO returned twice without a session."} ` +
        "No payment was attempted and search and comparison remain available. Allow cross-site cookies and the Clerk development-browser token in this same browser before trying again.";
      panel.append(kicker, note);
      this.scrollToLatest();
    }

    showWalletGate(product, options = {}) {
      this.rememberPendingPurchase(product, options);
      const panel = this.createPurchaseGate(
        "wallet",
        `Your account is signed in, but it does not have a verified Solana wallet. Add the wallet to this Clerk account before buying ${product.title}.`,
        this.purchaseGateKey("wallet", product, options),
      );
      if (!panel) return;
      const kicker = document.createElement("span");
      kicker.className = "inline-kicker";
      kicker.textContent = "Verified wallet required";
      const note = document.createElement("p");
      note.className = "inline-note";
      note.textContent =
        "No payment was attempted. You can keep searching and comparing products in this conversation.";
      panel.append(kicker, note);
      this.scrollToLatest();
    }

    showApprovalGate(product, options = {}, status = null) {
      const pending = this.rememberPendingPurchase(product, options);
      const budget = Number(pending.options.budget);
      const remaining = this.delegationRemaining(status);
      const panel = this.createPurchaseGate(
        "delegation",
        status?.active
          ? `The current ${remaining.toFixed(2)} USDC allowance is below this ${budget.toFixed(2)} USDC purchase cap. Set a new limit to continue.`
          : `Approve an on-chain spending limit before I buy ${product.title}. This is the only wallet approval step.`,
        this.purchaseGateKey(
          status?.active ? "delegation-insufficient" : "delegation",
          product,
          pending.options,
        ),
      );
      if (!panel) return;
      const kicker = document.createElement("span");
      kicker.className = "inline-kicker";
      kicker.textContent = status?.active ? "More allowance required" : "One-time SPL delegation";
      const note = document.createElement("p");
      note.className = "inline-note";
      note.textContent =
        "The broker can spend only within this USDC limit. Search and comparison do not require approval.";
      const row = document.createElement("div");
      row.className = "inline-action-row";
      const label = document.createElement("label");
      label.className = "inline-limit";
      label.textContent = "Limit · USDC";
      const input = document.createElement("input");
      input.type = "number";
      input.inputMode = "decimal";
      input.min = "0.000001";
      input.step = "0.01";
      input.value = Math.max(1, budget).toFixed(2);
      input.setAttribute("aria-label", "USDC delegation limit");
      label.append(input);
      const button = document.createElement("button");
      button.className = "primary";
      button.type = "button";
      button.textContent = "Approve once";
      button.addEventListener("click", () => this.approve(input, button));
      row.append(label, button);
      panel.append(kicker, note, row);
      this.scrollToLatest();
    }

    async toggleAuth(button) {
      const originalText = button?.textContent || "Sign in with Shopify";
      try {
        if (button) {
          button.disabled = true;
          button.textContent = "Opening secure sign-in…";
        }
        if (!this.authClient) await this.loadAuth();
        if (!this.authClient) {
          throw new Error(this.authError || "Shopify sign-in is unavailable.");
        }
        if (this.authClient.status()?.sessionActive) {
          await this.maybeResumePendingPurchase();
          return;
        }
        if (this.authBranch === "shopify_return_fallback") {
          await this.authClient.openFallbackSignIn();
        } else {
          await this.authClient.signInViaShopify(this.shopifyLoginUrl);
        }
      } catch (error) {
        this.appendMessage("agent", this.errorMessage(error));
      } finally {
        if (button?.isConnected) {
          button.disabled = false;
          button.textContent = originalText;
        }
      }
    }

    renderDelegation(status) {
      this.delegation = status;
    }

    async refreshDelegation() {
      if (!this.identity?.walletAddress || !this.authClient) return null;
      try {
        const status = await this.authClient.delegation();
        this.renderDelegation(status);
        return status;
      } catch (error) {
        this.delegationError = this.errorMessage(error);
        return null;
      }
    }

    delegationRemaining(status = this.delegation) {
      const amount = Number(status?.allowanceRemaining?.amount || 0);
      return Number.isFinite(amount) ? amount : 0;
    }

    delegationCovers(status, budget) {
      return Boolean(
        status?.active &&
        status?.approvalTxSignature &&
        this.delegationRemaining(status) + Number.EPSILON >= Number(budget),
      );
    }

    appendDelegationStatus(text, status = this.delegation) {
      if (!status?.active || !this.identity?.walletAddress) return;
      const { body } = this.appendMessage("agent", text);
      const controls = document.createElement("div");
      controls.className = "inline-delegation-status";
      const state = document.createElement("span");
      state.textContent =
        `${this.short(this.identity.walletAddress)} · ${status.allowanceRemaining?.amount || "0"} USDC left`;
      const button = document.createElement("button");
      button.className = "quiet-action";
      button.type = "button";
      button.textContent = "Revoke delegation";
      button.addEventListener("click", () => this.revoke(button));
      controls.append(state, button);
      body.append(controls);
    }

    async approve(input, button) {
      if (this.busy) return;
      const limit = Number(input?.value);
      if (!Number.isFinite(limit) || limit <= 0) {
        this.appendMessage("agent", "Enter a positive USDC delegation limit.");
        input?.focus();
        return;
      }
      let approved = false;
      this.setBusy(true);
      if (button) button.textContent = "Check Phantom…";
      try {
        const status = await this.authClient.approveDelegation(limit);
        this.renderDelegation(status);
        this.deactivatePurchaseGates();
        this.appendDelegationStatus(
          `On-chain limit approved: ${status.allowanceRemaining.amount} USDC. The broker can now buy from this wallet with 0 additional approval clicks until the limit is spent or revoked.`,
          status,
        );
        approved = true;
      } catch (error) {
        this.appendMessage("agent", this.errorMessage(error));
      } finally {
        if (button?.isConnected) button.textContent = "Approve once";
        this.setBusy(false);
      }
      if (approved) await this.maybeResumePendingPurchase();
    }

    async revoke(button) {
      if (this.busy) return;
      this.setBusy(true);
      if (button) button.textContent = "Check Phantom…";
      try {
        const status = await this.authClient.revokeDelegation();
        this.renderDelegation(status);
        this.shadowRoot.querySelectorAll(".inline-delegation-status")
          .forEach((controls) => controls.remove());
        this.appendMessage(
          "agent",
          "SPL delegation revoked on-chain. Future web purchases are blocked until you approve again.",
        );
      } catch (error) {
        this.appendMessage("agent", this.errorMessage(error));
      } finally {
        if (button?.isConnected) button.textContent = "Revoke delegation";
        this.setBusy(false);
      }
    }

    approvalTxSignature() {
      return this.delegation?.approvalTxSignature || "";
    }

    async requirePurchaseDelegation(product, options = {}) {
      const pending = this.rememberPendingPurchase(product, options);
      if (!this.authClient) await this.loadAuth();
      const authStatus = this.authClient?.status?.();
      if (!authStatus?.sessionActive) {
        this.showAuthStatusGate(product, pending.options, authStatus);
        return null;
      }
      if (!this.identity?.walletAddress) {
        this.showWalletGate(product, pending.options);
        return null;
      }
      const status = await this.refreshDelegation();
      if (!this.delegationCovers(status, pending.options.budget)) {
        this.showApprovalGate(product, pending.options, status);
        return null;
      }
      return status;
    }

    async maybeResumePendingPurchase() {
      if (!this.pendingPurchase || this.resumeInFlight || this.busy) return;
      const pending = this.pendingPurchase;
      const authStatus = this.authClient?.status?.();
      if (!authStatus?.sessionActive) {
        this.showAuthStatusGate(pending.product, pending.options, authStatus);
        return;
      }
      if (!this.identity?.walletAddress) {
        this.showWalletGate(pending.product, pending.options);
        return;
      }
      this.resumeInFlight = true;
      try {
        const status = await this.refreshDelegation();
        if (!this.delegationCovers(status, pending.options.budget)) {
          this.showApprovalGate(pending.product, pending.options, status);
          return;
        }
        this.deactivatePurchaseGates();
        this.clearPendingPurchase();
        await this.startPurchase(pending.product, {
          ...pending.options,
          skipGate: true,
        });
      } finally {
        this.resumeInFlight = false;
      }
    }

    parseBudget(text) {
      const patterns = [
        /(?:under|below|less\s+than|up\s+to|max(?:imum)?|budget(?:\s+of)?)\s*\$?\s*(\d+(?:\.\d+)?)/i,
        /\$\s*(\d+(?:\.\d+)?)/,
        /(\d+(?:\.\d+)?)\s*(?:dollars?|usd|usdc)\b/i,
      ];
      for (const pattern of patterns) {
        const match = text.match(pattern);
        const value = Number.parseFloat(match?.[1] || "");
        if (Number.isFinite(value) && value > 0) return value;
      }
      return null;
    }

    queryTokens(text) {
      const stop = new Set([
        "a", "an", "and", "below", "budget", "buy", "choose", "dollar", "dollars",
        "find", "for", "get", "i", "less", "max", "maximum", "me", "need", "of",
        "please", "show", "something", "than", "the", "to", "under", "up", "usd",
        "usdc", "want", "with", "you",
      ]);
      return text
        .toLowerCase()
        .replace(/\d+(?:\.\d+)?/g, " ")
        .split(/[^\p{L}\p{N}]+/u)
        .filter((token) => token.length > 1 && !stop.has(token));
    }

    productPrice(product) {
      if (Number.isFinite(product?.agentPrice)) return product.agentPrice;
      return Number(product.priceCents || 0) / 100;
    }

    productScore(product, tokens) {
      if (!tokens.length) return 1;
      const title = String(product.title || "").toLowerCase();
      const sku = String(product.sku || "").toLowerCase();
      const searchable = `${title} ${sku} ${product.tags || ""} ${product.description || ""}`.toLowerCase();
      return tokens.reduce((score, token) => {
        if (title.includes(token)) return score + 6;
        if (sku.includes(token)) return score + 4;
        if (searchable.includes(token)) return score + 2;
        return score;
      }, 0);
    }

    searchCatalog(text) {
      const budget = this.parseBudget(text);
      const tokens = this.queryTokens(text);
      const available = this.catalog.filter((product) => product.available);
      const scored = available
        .map((product) => ({ product, score: this.productScore(product, tokens) }))
        .filter((entry) => entry.score > 0)
        .sort((left, right) =>
          right.score - left.score ||
          this.productPrice(left.product) - this.productPrice(right.product) ||
          String(left.product.title).localeCompare(String(right.product.title)),
        );

      const realCatalogMatches = scored.filter(
        (entry) => !/^relay$/i.test(String(entry.product.vendor || "").trim()),
      );
      const rankedEntries = realCatalogMatches.length ? realCatalogMatches : scored;
      const preferredAvailable = available.filter(
        (product) => !/^relay$/i.test(String(product.vendor || "").trim()),
      );
      const ranked = rankedEntries.length
        ? rankedEntries.map((entry) => entry.product)
        : [...(preferredAvailable.length ? preferredAvailable : available)].sort(
            (left, right) => this.productPrice(left) - this.productPrice(right),
          );
      const withinBudget = budget == null
        ? ranked
        : ranked.filter((product) => this.productPrice(product) <= budget);
      const candidates = (withinBudget.length ? withinBudget : ranked).slice(0, 3);
      return { budget, tokens, candidates, hasBudgetMatch: budget == null || withinBudget.length > 0 };
    }

    selectionIndex(text) {
      const normalized = text.toLowerCase();
      if (/\b(?:first|1st|one|number\s*1)\b/.test(normalized)) return 0;
      if (/\b(?:second|2nd|two|number\s*2)\b/.test(normalized)) return 1;
      if (/\b(?:third|3rd|three|number\s*3)\b/.test(normalized)) return 2;
      return null;
    }

    delegated(text) {
      return /\b(?:delegate|you choose|agent choose|cheapest|best one|pick for me|buy it|go ahead)\b/i.test(text);
    }

    async submit(event) {
      event.preventDefault();
      if (this.busy) return;
      const input = this.$("#prompt");
      const text = input.value.trim();
      if (!text) return;
      input.value = "";
      if (this.pendingPurchase) {
        this.clearPendingPurchase();
        this.deactivatePurchaseGates();
      }
      this.appendMessage("user", text);
      await this.sendChat(text);
    }

    async sendChat(text) {
      if (this.busy) return;
      if (this.lastCandidates.length) {
        const requestedIndex = this.selectionIndex(text);
        const explicitSelection =
          requestedIndex != null &&
          /\b(?:buy|choose|pay|order|take|select|want)\b/i.test(text);
        if (explicitSelection || this.delegated(text)) {
          const product = this.lastCandidates[requestedIndex ?? 0];
          if (product) {
            await this.startPurchase(product, {
              announceSelection: false,
              budget: this.lastIntent?.budget || this.defaultBudget(product),
            });
            return;
          }
        }
      }
      this.setBusy(true);
      let result;
      try {
        const body = {
          sessionId: this.agentSessionId,
          message: text,
          ...(this.approvalTxSignature()
            ? { approvalTxSignature: this.approvalTxSignature() }
            : {}),
        };
        result = this.identity?.walletAddress
          ? await this.authClient.signedJson("/chat", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body),
            })
          : await this.fetchJson("/chat", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body),
            });
      } catch (error) {
        // A preview theme can briefly point at the previous buyer revision while
        // a new API revision awaits coordinator-approved deployment. Preserve
        // the original deterministic search/payment path during that window.
        this.setBusy(false);
        await this.legacyTurn(text, error);
        return;
      }

      try {
        this.renderChatResponse(result);
      } catch (error) {
        // Never retry a successful /chat call through /buy: the model may have
        // already sent payment, and a display failure must not spend twice.
        this.appendMessage(
          "agent",
          `The agent response could not be displayed: ${this.errorMessage(error)}`,
        );
      } finally {
        this.setBusy(false);
        this.$("#prompt").focus();
        this.scrollToLatest();
      }
    }

    renderChatResponse(result) {
      const reply = String(result?.reply || "").trim();
      if (!reply) throw new Error("The buyer agent returned no reply.");
      const { body } = this.appendMessage("agent", reply);
      const products = (Array.isArray(result.products) ? result.products : [])
        .map((product) => this.normalizeAgentProduct(product));
      this.lastCandidates = products;
      const parsedBudget = Number(result?.search?.budget);
      if (Number.isFinite(parsedBudget) && parsedBudget > 0) {
        this.lastIntent = { budget: parsedBudget };
      }

      if (products.length) {
        const cards = document.createElement("div");
        cards.className = "cards";
        products.slice(0, 3).forEach((product) =>
          cards.append(this.productCard(product, this.lastIntent?.budget)),
        );
        body.append(cards);
      }

      if (result?.quote || result?.payment || result?.confirmation) {
        const budget = this.lastIntent?.budget ||
          Number(result?.quote?.price?.amount) ||
          0;
        const progress = this.createProgressElement(body, budget);
        this.renderResult(progress, result, budget, { appendSummary: false });
      }
      this.scrollToLatest();
    }

    normalizeAgentProduct(product) {
      const local = this.catalog.find(
        (candidate) =>
          product?.title && String(candidate.title) === String(product.title),
      ) || this.catalog.find(
        (candidate) =>
          product?.sku && String(candidate.sku) === String(product.sku),
      ) || {};
      const agentPrice = Number(product?.price);
      const inventory = Number(product?.inventoryQuantity);
      return {
        ...local,
        ...product,
        image: local.image || product?.image || null,
        url: local.url || product?.url || "",
        handle: local.handle || product?.handle || "",
        vendor: local.vendor || product?.vendor || "Shopify",
        agentPrice: Number.isFinite(agentPrice) ? agentPrice : null,
        inventoryQuantity: Number.isFinite(inventory) ? inventory : null,
        available: Number.isFinite(inventory) ? inventory > 0 : Boolean(local.available),
      };
    }

    async chooseProduct(product) {
      if (this.busy || !product) return;
      const budget = this.lastIntent?.budget || this.defaultBudget(product);
      await this.startPurchase(product, { budget });
    }

    async legacyTurn(text, chatError) {
      if (this.lastCandidates.length) {
        const requestedIndex = this.selectionIndex(text);
        if (requestedIndex != null && this.lastCandidates[requestedIndex]) {
          await this.startPurchase(this.lastCandidates[requestedIndex], { announceSelection: false });
          return;
        }
        if (this.delegated(text)) {
          await this.startPurchase(this.lastCandidates[0], { announceSelection: false });
          return;
        }
      }
      this.showCandidates(text);
      this.dataset.chatFallback = this.errorMessage(chatError).slice(0, 180);
    }

    formatMoney(product) {
      const value = this.productPrice(product);
      if (Number.isFinite(product.agentPrice)) {
        return `${value.toFixed(2)} USDC`;
      }
      try {
        return new Intl.NumberFormat(undefined, {
          style: "currency",
          currency: this.currency,
          minimumFractionDigits: 2,
        }).format(value);
      } catch {
        return `${value.toFixed(2)} ${this.currency}`;
      }
    }

    showCandidates(text) {
      const intent = this.searchCatalog(text);
      this.lastIntent = intent;
      this.lastCandidates = intent.candidates;

      if (!this.catalog.length) {
        this.appendMessage(
          "agent",
          "The live Shopify catalog is empty right now, so I can’t present a real product candidate.",
        );
        return;
      }
      if (!intent.candidates.length) {
        this.appendMessage(
          "agent",
          "I couldn’t find an in-stock item in the live catalog. Try a different product description.",
        );
        return;
      }

      const cap = intent.budget == null ? "" : ` under your ${intent.budget.toFixed(2)} USDC cap`;
      const copy = intent.hasBudgetMatch
        ? `I found ${intent.candidates.length} live catalog ${intent.candidates.length === 1 ? "match" : "matches"}${cap}. Prices and availability below come directly from Shopify.`
        : `Nothing in stock fits the ${intent.budget.toFixed(2)} USDC cap. These are the closest live catalog matches; I won’t let the wallet exceed your cap.`;
      const { body } = this.appendMessage("agent", copy);

      const cards = document.createElement("div");
      cards.className = "cards";
      intent.candidates.forEach((product) => cards.append(this.productCard(product, intent.budget)));
      body.append(cards);

      if (intent.hasBudgetMatch) {
        const delegate = document.createElement("div");
        delegate.className = "delegate";
        const note = document.createElement("span");
        note.textContent = "Or delegate the choice: I’ll take the best-ranked in-stock match.";
        const button = document.createElement("button");
        button.className = "primary";
        button.type = "button";
        button.textContent = "Let agent choose";
        button.addEventListener("click", () =>
          this.startPurchase(intent.candidates[0], { budget: intent.budget }),
        );
        delegate.append(note, button);
        body.append(delegate);
      }
      this.scrollToLatest();
    }

    productCard(product, budget) {
      const card = document.createElement("article");
      card.className = "card";

      const media = document.createElement("div");
      media.className = "card-media";
      if (product.image) {
        const image = document.createElement("img");
        image.src = product.image;
        image.alt = "";
        image.loading = "lazy";
        image.addEventListener("error", () => image.remove());
        media.append(image);
      }
      const stock = document.createElement("span");
      stock.className = "stock";
      stock.textContent = Number.isFinite(product.inventoryQuantity)
        ? `${product.inventoryQuantity} left`
        : product.available ? "In stock" : "Sold out";
      media.append(stock);

      const copy = document.createElement("div");
      copy.className = "card-copy";
      const title = document.createElement("h3");
      title.textContent = product.title || "Untitled product";
      const price = document.createElement("p");
      price.className = "price";
      price.textContent = this.formatMoney(product);
      const meta = document.createElement("span");
      meta.className = "catalog-meta";
      meta.textContent = `${product.vendor || "Shopify"} live catalog · agent price`;

      const actions = document.createElement("div");
      actions.className = "card-actions";
      const choose = document.createElement("button");
      choose.className = "primary";
      choose.type = "button";
      const overCap = budget != null && this.productPrice(product) > budget;
      choose.disabled = !product.available || overCap;
      choose.textContent = overCap ? "Over cap" : "Choose + pay";
      choose.addEventListener("click", () => this.chooseProduct(product));

      const detail = document.createElement("a");
      detail.className = "secondary";
      detail.href = product.url || `/products/${encodeURIComponent(product.handle || "")}`;
      detail.textContent = "Details ↗";
      detail.setAttribute("aria-label", `View details for ${product.title}`);
      actions.append(choose, detail);
      copy.append(title, price, meta, actions);
      card.append(media, copy);
      return card;
    }

    defaultBudget(product) {
      return Math.max(1, Math.ceil(this.productPrice(product) * 1.25 * 100) / 100);
    }

    createProgress(product, budget) {
      const { body } = this.appendMessage(
        "agent",
        `Delegation accepted for ${product.title}. The payment rail now runs autonomously; there are no wallet or Shopify checkout approval clicks.`,
      );
      return this.createProgressElement(body, budget);
    }

    createProgressElement(body, budget) {
      const progress = document.createElement("section");
      progress.className = "progress";
      progress.setAttribute("aria-label", "Autonomous purchase progress");
      progress.innerHTML = `
        <div class="progress-head">
          <span class="progress-title">Autonomous settlement</span>
          <span class="state active" data-run-state>[ IN PROGRESS ]</span>
        </div>
        <div class="step" data-step="1">
          <span class="step-number">01</span>
          <div><strong>A2A payment request</strong><p>Shopping agent sources the exact catalog item and issues a Solana Pay request.</p></div>
          <span class="step-value">REQUESTING</span>
        </div>
        <div class="step" data-step="2">
          <span class="step-number">02</span>
          <div><strong>Autonomous signature</strong><p>Buyer wallet signs after the budget guard accepts the quote.</p></div>
          <span class="step-value">QUEUED</span>
        </div>
        <div class="step" data-step="3">
          <span class="step-number">03</span>
          <div><strong>USDC on-chain</strong><p>Transfer is broadcast on Solana devnet with a unique reference.</p></div>
          <span class="step-value">QUEUED</span>
        </div>
        <div class="step" data-step="4">
          <span class="step-number">04</span>
          <div><strong>Verify + order</strong><p>Shopping agent verifies by reference before writing the Shopify order ledger.</p></div>
          <span class="step-value">QUEUED</span>
        </div>
      `;
      body.append(progress);
      const safeBudget = Number.isFinite(budget) ? budget : 0;
      this.updateStep(
        progress,
        1,
        "ACTIVE",
        safeBudget > 0 ? `${safeBudget.toFixed(2)} USDC CAP` : "REQUESTING",
      );
      this.scrollToLatest();
      return progress;
    }

    updateStep(progress, number, state, value) {
      const step = progress.querySelector(`[data-step="${number}"]`);
      if (!step) return;
      step.dataset.state = state.toLowerCase();
      const output = step.querySelector(".step-value");
      output.textContent = value || state;
      output.title = value || state;
    }

    short(value, head = 9, tail = 7) {
      const text = String(value || "");
      if (!text) return "—";
      return text.length > head + tail + 3
        ? `${text.slice(0, head)}…${text.slice(-tail)}`
        : text;
    }

    safeExplorerUrl(value, signature) {
      if (value) {
        try {
          const url = new URL(value);
          if (url.protocol === "https:") return url.href;
        } catch {}
      }
      return signature
        ? `https://explorer.solana.com/tx/${encodeURIComponent(signature)}?cluster=${encodeURIComponent(this.cluster)}`
        : "";
    }

    renderResult(progress, result, budget, options = {}) {
      const quote = result?.quote || {};
      const payment = result?.payment || {};
      const confirmation = result?.confirmation || {};
      const signature = payment.txSignature || confirmation.txSignature || "";
      const explorer = this.safeExplorerUrl(confirmation.explorer || payment.explorer, signature);
      const status = String(confirmation.status || "").toLowerCase();
      const reason = String(result?.reason || "");
      const quotedAmount = quote.price?.amount
        ? `${quote.price.amount} ${quote.price.currency || "USDC"}`
        : "NO QUOTE";

      if (!quote.orderRef && !quote.reference && !quote.title) {
        throw new Error(reason || "The shopping agent returned no quote.");
      }
      this.updateStep(progress, 1, "DONE", `${quotedAmount} · ${this.short(quote.reference)}`);

      if (!signature) {
        this.updateStep(progress, 2, "SKIPPED", "NOT SIGNED");
        this.updateStep(progress, 3, "SKIPPED", "NOT SENT");
        this.updateStep(progress, 4, "SKIPPED", "NOT RECORDED");
        const runState = progress.querySelector("[data-run-state]");
        runState.textContent = result?.ok === false ? "[ BUDGET GUARD ]" : "[ FAILED ]";
        runState.className = "state";
        const safeBudget = Number.isFinite(budget) ? budget : 0;
        const message = reason ||
          `No payment signature was returned${safeBudget > 0 ? ` within the ${safeBudget.toFixed(2)} USDC cap` : ""}.`;
        if (options.appendSummary !== false) {
          this.appendMessage("agent", `${message} No funds were sent.`);
        }
        return;
      }

      this.updateStep(progress, 2, "DONE", `SIGNED · ${this.short(signature)}`);
      this.updateStep(progress, 3, "DONE", `ON-CHAIN · ${String(quote.network || this.cluster).toUpperCase()}`);

      if (status === "paid") {
        const orderId = confirmation.shopifyOrderId || confirmation.orderRef || quote.orderRef;
        this.updateStep(progress, 4, "DONE", `PAID · ${this.short(orderId)}`);
        const runState = progress.querySelector("[data-run-state]");
        runState.textContent = "[ PAID ]";
        runState.className = "state done";
        this.showProof(progress, explorer, signature, orderId);
        if (options.appendSummary !== false) {
          this.appendMessage(
            "agent",
            `Purchase complete: ${quote.title || "catalog item"} for ${quotedAmount}. Shopify order ${orderId || "recorded"} was created only after on-chain verification.`,
          );
        }
      } else if (status === "pending") {
        this.updateStep(progress, 4, "ACTIVE", `VERIFYING · ${this.short(confirmation.orderRef || quote.orderRef)}`);
        const runState = progress.querySelector("[data-run-state]");
        runState.textContent = "[ VERIFYING ]";
        this.showProof(progress, explorer, signature, confirmation.orderRef || quote.orderRef);
        if (options.appendSummary !== false) {
          this.appendMessage("agent", "The transfer is on-chain and the order reference is still being verified.");
        }
      } else {
        this.updateStep(progress, 4, "FAILED", (status || "FAILED").toUpperCase());
        const runState = progress.querySelector("[data-run-state]");
        runState.textContent = `[ ${(status || "FAILED").toUpperCase()} ]`;
        runState.className = "state";
        this.showProof(progress, explorer, signature, confirmation.orderRef || quote.orderRef);
        if (options.appendSummary !== false) {
          this.appendMessage("agent", reason || `Settlement finished with status: ${status || "unknown"}.`);
        }
      }
    }

    showProof(progress, explorer, signature, orderId) {
      if (!signature || !explorer) return;
      const proof = document.createElement("div");
      proof.className = "proof";
      const kicker = document.createElement("span");
      kicker.className = "proof-kicker";
      kicker.textContent = `[ ON-CHAIN PROOF · ORDER ${this.short(orderId)} ]`;
      const link = document.createElement("a");
      link.href = explorer;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = "Open Solana explorer ↗";
      const code = document.createElement("span");
      code.className = "proof-code";
      code.textContent = signature;
      code.title = signature;
      proof.append(kicker, link, code);
      progress.append(proof);
    }

    renderFailure(progress, error) {
      [1, 2, 3, 4].forEach((number) => {
        this.updateStep(progress, number, number === 1 ? "FAILED" : "SKIPPED", number === 1 ? "REQUEST FAILED" : "NOT RUN");
      });
      const runState = progress.querySelector("[data-run-state]");
      runState.textContent = "[ FAILED ]";
      runState.className = "state";
      this.appendMessage("agent", `${this.errorMessage(error)} No Shopify checkout was opened.`);
    }

    setBusy(value) {
      this.busy = value;
      this.$("#send").disabled = value;
      this.$("#prompt").disabled = value;
      this.shadowRoot.querySelectorAll(
        ".card button, .delegate button, .inline-actions button, .inline-delegation-status button",
      ).forEach((button) => {
        button.disabled = value || button.textContent === "Over cap";
      });
      this.shadowRoot.querySelectorAll(".inline-actions input").forEach((input) => {
        input.disabled = value;
      });
    }

    async startPurchase(product, options = {}) {
      if (this.busy || !product) return;
      const budget = Number(
        options.budget || this.lastIntent?.budget || this.defaultBudget(product),
      );
      if (!options.skipGate) {
        const delegation = await this.requirePurchaseDelegation(product, {
          ...options,
          budget,
        });
        if (!delegation) return;
      }
      this.deactivatePurchaseGates();
      this.clearPendingPurchase();
      if (options.announceSelection !== false) {
        this.appendMessage("user", `Choose ${product.title} and pay autonomously.`);
      }
      const progress = this.createProgress(product, budget);
      this.setBusy(true);

      const waitingUpdate = window.setTimeout(() => {
        this.updateStep(progress, 1, "ACTIVE", "AWAITING A2A RESPONSE");
      }, 1800);

      try {
        const result = await this.authClient.signedJson("/web/buy", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            query: product.title,
            budget,
            shipTo: this.shipTo,
            approvalTxSignature: this.approvalTxSignature(),
          }),
        });
        this.renderResult(progress, result, budget);
        const status = await this.refreshDelegation();
        if (status?.active) {
          this.appendDelegationStatus(
            "Your remaining on-chain limit is shown here only because a purchase just finished.",
            status,
          );
        }
      } catch (error) {
        this.renderFailure(progress, error);
      } finally {
        window.clearTimeout(waitingUpdate);
        this.setBusy(false);
        this.$("#prompt").focus();
        this.scrollToLatest();
      }
    }
  }

  customElements.define("relay-agent-chat", RelayAgentChat);
})();
</script>
{% endraw %}

