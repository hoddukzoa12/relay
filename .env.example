# ============================================================================
#  Agentic Resell Broker — environment template
#  Copy to `.env` and fill in.  NEVER commit the real .env (see .gitignore).
# ============================================================================

# --- Solana ------------------------------------------------------------------
# RPC endpoint. For the demo, list a fallback too (RPC multiplexing = risk plan).
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL_FALLBACK=https://rpc.ankr.com/solana_devnet
SOLANA_CLUSTER=devnet

# Devnet USDC mint. Default below is Circle's official devnet USDC.
# ⚠️  Confirm this matches the token you actually airdropped to your wallets.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_DECIMALS=6

# --- Wallets -----------------------------------------------------------------
# Two ways to supply a key — the payments service accepts either:
#   (a) base58 secret key string, or
#   (b) a path to a solana-keygen id.json (JSON array of bytes).
# Provide ONE of each pair. Keypair-path is easiest since you already have wallets.
MERCHANT_WALLET_KEYPAIR_PATH=./wallets/merchant.json
BUYER_WALLET_KEYPAIR_PATH=./wallets/buyer.json
# MERCHANT_WALLET_SECRET=
# BUYER_WALLET_SECRET=

# --- Service URLs (internal REST between agents ↔ services) -------------------
PAYMENTS_SERVICE_URL=http://localhost:8081
COMMERCE_SERVICE_URL=http://localhost:8082
SHOPPING_AGENT_URL=http://localhost:8091
BUYER_AGENT_URL=http://localhost:8090

# Ports
PAYMENTS_PORT=8081
COMMERCE_PORT=8082
SHOPPING_PORT=8091
BUYER_PORT=8090
MCP_PORT=8092

# Remote MCP endpoint authentication. Generate a high-entropy shared secret
# (for example, `openssl rand -hex 32`) and send it as X-Relay-API-Key.
MCP_API_KEY=
# CORS and MCP SDK DNS-rebinding protection are separate checks. Cloud Run
# fills both service hostnames into MCP_ALLOWED_HOSTS during deployment.
MCP_CORS_ORIGINS=*
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Browser origins allowed to call the buyer agent (comma-separated, no paths).
# Include every Shopify storefront origin that will host the embedded widget.
# SHOPIFY_STORE_DOMAIN below is also allowed automatically when it is configured.
BUYER_CORS_ORIGINS=https://your-store.myshopify.com,https://shop.example.com

# --- Clerk wallet identity ---------------------------------------------------
# Clerk provides Sign in with Solana and is configured as Shopify's OIDC IdP.
# The publishable key is safe for browsers; the secret key is backend-only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# --- Gemini (Google AI Studio API key; free tier is fine) --------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-2.5-flash

# --- Shopify Admin API -------------------------------------------------------
# Leave COMMERCE_MOCK=true until your dev store + credentials are ready.
# Required scopes: read/write_orders (order ledger), read/write_products +
# read/write_inventory (catalog retrieval and `pnpm seed:catalog`),
# read/write_fulfillments (order fulfillment), read/write_themes (app block).
COMMERCE_MOCK=true
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-01
# LEGACY path: a static token from a custom app created in the store admin.
# Only for stores that already have one — new stores use the client credentials
# grant below instead. When both are set, the static token wins.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Shopify Dev Dashboard app (client credentials grant) --------------------
# PREFERRED for new stores. Since 2026-01-01 merchants can no longer create
# legacy custom apps (which is where the static shpat_ token above came from).
# Instead, create an app in the Dev Dashboard and exchange these credentials for
# a short-lived Admin API token at runtime:
#   POST https://{shop}.myshopify.com/admin/oauth/access_token
#        grant_type=client_credentials & client_id & client_secret
#   -> { access_token, scope, expires_in }   ← expires_in is always 86399 (24h)
# The commerce service and catalog seeder fetch, cache, and refresh this token;
# do NOT paste a token into SHOPIFY_ADMIN_ACCESS_TOKEN when using this path.
#
# ⚠️  The grant only works when the app AND the store are in the SAME Shopify
#     organization. Create the dev store from the Dev Dashboard "Dev stores"
#     page — a store created from the Shopify admin is NOT in the org and fails
#     with `shop_not_permitted`.
# Dev Dashboard -> your app -> Settings -> Client ID / Client secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Carrier tracking (structure-only demo) ----------------------------------
# Optional official EasyPost Tracker API key. Fulfillment uses EasyPost's
# documented test tracking number and is NOT a real shipment. With no key, the
# endpoint returns an explicit demo/not-configured state and never scrapes.
EASYPOST_API_KEY=

# --- Google Cloud (Cloud Run deploy + Shopify webhooks via Pub/Sub) ----------
GCP_PROJECT_ID=
GCP_REGION=us-central1
PUBSUB_TOPIC_ID=shopify-events

# --- Broker economics --------------------------------------------------------
# Markup applied to sourced cost to set the resale price (revenue model).
BROKER_MARKUP_PCT=15
# Minutes a payment request stays valid.
PAYMENT_REQUEST_TTL_MIN=15
