{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-resell-broker/schemas/order-confirmation.json",
  "title": "OrderConfirmation",
  "description": "Final confirmation returned by the shopping agent to the buyer agent (PRD §6, Step 11).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderRef",
    "status",
    "txSignature",
    "explorer",
    "shopifyOrderId",
    "supplierOrder"
  ],
  "properties": {
    "orderRef": { "type": "string" },
    "status": { "enum": ["pending", "paid", "expired", "invalid"] },
    "txSignature": { "type": ["string", "null"] },
    "explorer": { "type": ["string", "null"] },
    "shopifyOrderId": { "type": ["string", "null"] },
    "supplierOrder": { "$ref": "#/$defs/supplierOrder" }
  },
  "$defs": {
    "supplierOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "status", "ref", "message"],
      "properties": {
        "provider": { "const": "dsers" },
        "status": {
          "enum": [
            "disabled",
            "blocked",
            "not_connected",
            "pending",
            "submitted",
            "confirmed",
            "failed"
          ]
        },
        "ref": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
