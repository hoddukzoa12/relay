{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-resell-broker/schemas/catalog-products.json",
  "title": "CatalogProductsResponse",
  "description": "Real Shopify variants returned by the commerce catalog endpoint for grounded sourcing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "variantId",
          "sku",
          "title",
          "description",
          "price",
          "inventoryQuantity",
          "status",
          "tags",
          "supplierCost"
        ],
        "properties": {
          "productId": { "type": "string" },
          "variantId": { "type": "string" },
          "sku": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "price": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,6})?$"
          },
          "inventoryQuantity": { "type": "integer" },
          "status": { "const": "ACTIVE" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supplierCost": {
            "oneOf": [
              { "$ref": "#/$defs/supplierCostSnapshot" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "supplierCostSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "source",
        "capturedAt",
        "shipTo",
        "supplierUrl"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,6})?$"
        },
        "currency": { "const": "USD" },
        "source": {
          "enum": ["dsers_mcp_snapshot", "relay_demo_catalog"]
        },
        "capturedAt": { "type": "string", "minLength": 1 },
        "shipTo": { "type": "string", "minLength": 2 },
        "supplierUrl": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
