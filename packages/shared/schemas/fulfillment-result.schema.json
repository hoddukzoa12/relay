{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.example/schemas/fulfillment-result.schema.json",
  "title": "FulfillmentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shopifyOrderId",
    "orderRef",
    "name",
    "fulfillmentStatus",
    "tracking",
    "replayed"
  ],
  "properties": {
    "shopifyOrderId": { "type": "string" },
    "orderRef": { "type": "string" },
    "name": { "type": "string" },
    "fulfillmentStatus": { "const": "FULFILLED" },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "carrier",
        "trackingNumber",
        "status",
        "statusDetail",
        "trackingUrl",
        "estimatedDeliveryAt",
        "demo",
        "message"
      ],
      "properties": {
        "provider": { "enum": ["shopify", "easypost"] },
        "carrier": { "type": "string", "minLength": 1 },
        "trackingNumber": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "statusDetail": { "type": ["string", "null"] },
        "trackingUrl": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "estimatedDeliveryAt": { "type": ["string", "null"] },
        "demo": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "replayed": { "type": "boolean" }
  }
}
