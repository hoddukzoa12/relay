{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-resell-broker/schemas/delegation-approval-required.json",
  "title": "DelegationApprovalRequired",
  "description": "Fail-closed response for an authenticated payer whose live SPL allowance cannot cover the purchase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "delegator",
    "requiredAmount",
    "allowanceRemaining",
    "balance",
    "approvalUrl"
  ],
  "properties": {
    "status": { "const": "approval-required" },
    "reason": { "type": "string", "minLength": 1 },
    "delegator": { "type": "string" },
    "requiredAmount": { "$ref": "#/$defs/money" },
    "allowanceRemaining": { "$ref": "#/$defs/money" },
    "balance": { "$ref": "#/$defs/money" },
    "approvalUrl": { "type": "string", "format": "uri" }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,6})?$" },
        "currency": { "const": "USDC" }
      }
    }
  }
}
